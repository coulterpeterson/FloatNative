# Database Configuration (the MySQL/MariaDB database you create in CloudPanel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=floatnative
DB_PASSWORD=change_me
DB_NAME=floatnative

# Floatplane Configuration
